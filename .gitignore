# COMMIT EDILECEKLER (asagidaki kurallarla dislanmaz):
# src/main/ ve src/test/ - kaynak kod ve regresyon testleri
# pom.xml, .gitignore, .github/ - derleme ve depo ayarlari
# README.MD, ANALYSIS.md, LICENSE ve diger proje belgeleri
# Maven wrapper dosyalari varsa .mvn/ ve mvnw / mvnw.cmd

# COMMIT EDILMEYECEKLER:
# Derleme ciktilari ve uretilen Maven dosyalari
/target/
/build/
/dist/
/dependency-reduced-pom.xml
*.class
*.jar
*.war
*.ear
!.mvn/wrapper/maven-wrapper.jar

# Kisisel IDE ayarlari
.idea/
.vscode/
*.iws
*.iml
*.ipr
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/

# Yerel AI arac kayitlari ve oturum verileri
.token-optimizer/
.codex/

# Yerel ortam, kimlik bilgileri ve ozel anahtarlar
.env
.env.*
!.env.example
!.env.sample
/secrets/
/credentials.json
/settings-security.xml
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Proje kokunde uygulamayi calistirinca olusan yerel veriler
# Paylasilacak ornekleri examples/ altinda, gizli bilgiler olmadan tut.
/settings.yml
/placeholders.yml
/app/
/containers/
/public/
/addons/

# Loglar, gecici dosyalar ve isletim sistemi dosyalari
/logs/
*.log
*.tmp
*.bak
*.swp
*~
hs_err_pid*
replay_pid*
.DS_Store
Thumbs.db
Desktop.ini

# NOT: .gitignore daha once takip edilen dosyalari otomatik cikartmaz.
# Gizli bilgileri kaynak koda yazma; bu liste bir gizli bilgi tarayicisi degildir.
